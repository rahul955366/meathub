# ====================================
# MeatHub Backend Environment Variables
# ====================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ====================================
# Django Core Settings
# ====================================

# REQUIRED: Generate a new secret key for production
# Run: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-minimum-50-characters-generate-new-one

# Debug mode (True for development, False for production)
DEBUG=False

# Allowed hosts (comma-separated, no spaces)
# Example: ALLOWED_HOSTS=meathub.com,www.meathub.com,api.meathub.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ====================================
# Database Configuration
# ====================================

# PostgreSQL connection URL
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://meathub_user:meathub_password@db:5432/meathub

# ====================================
# CORS Configuration
# ====================================

# Allowed origins for CORS (comma-separated, no spaces)
# Example: CORS_ALLOWED_ORIGINS=https://meathub.com,https://www.meathub.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ====================================
# Email Configuration (for password reset)
# ====================================

# Email backend (use console for development, smtp for production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP settings (required for production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# From email address
DEFAULT_FROM_EMAIL=noreply@meathub.com

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000

# ====================================
# Google Gemini AI Configuration
# ====================================

# Get API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ====================================
# Razorpay Payment Gateway
# ====================================

# Get keys from: https://dashboard.razorpay.com/app/keys
# Use test keys (rzp_test_...) for development
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ====================================
# Development Quick Start
# ====================================

# For local development, you can use these minimal settings:
# SECRET_KEY=django-insecure-dev-only-change-in-production-abc123xyz789
# DEBUG=True
# DATABASE_URL=postgres://meathub_user:meathub_password@db:5432/meathub
# GEMINI_API_KEY=your-gemini-key
# RAZORPAY_KEY_ID=rzp_test_your_key
# RAZORPAY_KEY_SECRET=your_secret
